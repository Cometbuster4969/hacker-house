# ══════════════════════════════════════════════════════════════
# FRAUD INVESTIGATION AGENT — Configuration
# ══════════════════════════════════════════════════════════════

# ── TigerGraph ──────────────────────────────────────────────
TIGERGRAPH_HOST=https://YOUR_WORKSPACE.tgcloud.io
TIGERGRAPH_TOKEN=your_token_here
TIGERGRAPH_GRAPH=FraudInvestigation
TIGERGRAPH_USE_SAVANNA=true

# ── LLM Provider ────────────────────────────────────────────
# Set ONE of these. The agent auto-detects the best available.
# Priority: openai > anthropic > grok > openrouter > mock
#
# For evaluators (no rate limiting):
#   OPENAI_API_KEY=sk-...
#   ANTHROPIC_API_KEY=sk-ant-...
#   GROK_API_KEY=xai-...
#
# For you (rate limited for free tier):
#   OPENROUTER_API_KEY=sk-or-...
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=llama-3.3-70b

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# ── OpenRouter Free Model Shortcuts ─────────────────────────
# Use these short names in LLM_MODEL, or the full :free ID:
#
#   llama-3.3-70b      → meta-llama/llama-3.3-70b-instruct:free
#   nemotron-120b      → nvidia/nemotron-3-super-120b-a12b:free
#   qwen3-80b          → qwen/qwen3-next-80b-a3b-instruct:free
#   llama-4-maverick   → meta-llama/llama-4-maverick:free
#   gemma-4-31b        → google/gemma-4-31b-it:free
#   gpt-oss-120b       → openai/gpt-oss-120b:free
#
# Recommended: llama-3.3-70b (best balance of quality + availability)

# ── Application ─────────────────────────────────────────────
DATA_DIR=./data/HHGOA_IEEE
CASES_DIR=./cases
LOG_LEVEL=INFO
PORT=8000
