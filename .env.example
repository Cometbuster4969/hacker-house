# TigerGraph Configuration
TIGERGRAPH_HOST=https://savanna.tgcloud.io
TIGERGRAPH_TOKEN=
TIGERGRAPH_GRAPH=FraudInvestigation
TIGERGRAPH_USE_SAVANNA=true

# LLM Configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o

# Application
DATA_DIR=./data/HHGOA_IEEE
CASES_DIR=./cases
LOG_LEVEL=INFO
PORT=8000

# Agent Settings
FRAUD_PROBABILITY_THRESHOLD=0.70
HIGH_RISK_THRESHOLD=0.85
LOW_RISK_THRESHOLD=0.15
EXPOSURE_THRESHOLD_SAR=1000
EXPOSURE_THRESHOLD_ESCALATE=500
EXPOSURE_THRESHOLD_L2=2500
